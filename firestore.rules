rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email_verified == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidRsvp(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (data.attendance == 'yes' || data.attendance == 'no') &&
             data.guestCount is int && data.guestCount >= 1 && data.guestCount <= 10 &&
             (!('message' in data) || (data.message is string && data.message.size() <= 500)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50));
    }

    // Public wedding invitation content
    match /wedding/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Guest RSVPs
    match /rsvps/{rsvpId} {
      allow create: if isValidId(rsvpId) && isValidRsvp(request.resource.data);
      allow read, list, delete: if isAdmin();
      allow update: if false;
    }
  }
}
